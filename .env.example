# ─────────────────────────────────────────────────────────────────────────────
# Amway Telegram Bot — пример переменных окружения.
#
#   cp .env.example .env     # .env в .gitignore, реальные секреты — только туда
#
# Файл синхронизирован с config/settings.py (F-15): перечислены ровно те
# переменные, которые читаются через os.getenv(...). Метки в комментариях:
#   [обязательно] — без значения соответствующий режим не работает;
#   [опционально] — в коде есть дефолт.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────────
# [обязательно] Токен от @BotFather. Нужен всем режимам, которые ходят в Bot API
# (publish, responder, bot_listener). Без него: "TELEGRAM_BOT_TOKEN is not set".
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# [опционально; legacy] Исторический target публикации: id группы (начинается
# с -100…) или личный chat_id. Сейчас — последний fallback в цепочке
# GROUP → ADMIN → CHAT (config/settings.py). Оставьте пустым в новых деплоях.
TELEGRAM_CHAT_ID=

# [опционально] Chat id исполнителя: сюда src/main.py отправляет превью поста
# перед публикацией. Пусто — превью не отправляется (публикуем сразу в группу).
TELEGRAM_ADMIN_CHAT_ID=

# [обязательно для публикации] Группа, в которую публикуются посты (id вида
# -100…). Режим --publish-prepared отказывается работать без неё, а не
# подставляет fallback-чат (src/main.py, exit code 5).
TELEGRAM_GROUP_CHAT_ID=-100xxxxxxxxxx

# ── LLM ──────────────────────────────────────────────────────────────────────
# [опционально] Основной провайдер: gemini (дефолт) | groq.
# Определяет порядок вызова в src/rewriter.py:call_llm().
LLM_PROVIDER=gemini

# [опционально] Читается config/settings.py, но текущий fallback в
# src/rewriter.py:call_llm() выбирает второго провайдера по наличию ключа,
# а не по этой переменной. Оставлена для совместимости конфигов.
LLM_FALLBACK=groq

# [обязательно при LLM_PROVIDER=gemini] Ключ Gemini: https://aistudio.google.com
# Используется и для рерайта, и для vision-гейта (src/media_validator.py).
GEMINI_API_KEY=your_gemini_api_key

# [опционально] Ключ Groq: https://console.groq.com. Нужен как fallback при
# сбое Gemini и обязателен при LLM_PROVIDER=groq. Пусто — fallback отключён.
GROQ_API_KEY=

# ── Прочее ───────────────────────────────────────────────────────────────────
# [опционально] Рециклинг «вечнозелёных» статей: через сколько дней опубликованную
# статью можно использовать снова. Целое число, <=0 отключает рециклинг.
# Дефолт в коде: 90.
PUBLISHED_COOLDOWN_DAYS=90

# CI-only, в .env не нужен: GH_PAT (scope repo) задаётся в GitHub Secrets и
# используется только .github/workflows/responder.yml для push
# data/last_update_id.txt. Остальные секреты workflows берут те же имена,
# что перечислены выше (TELEGRAM_*, GROQ_API_KEY, GEMINI_API_KEY).
